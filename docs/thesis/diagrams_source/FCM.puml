@startuml
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Arial
skinparam dpi 300

title Fuzzy kognitív térkép (FCM)

left to right direction

rectangle "Bemeneti réteg (Szenzorok & receptorok)" {
  [Hunger] as IN_Hunger
  [Thirst] as IN_Thirst
  [Energy] as IN_Energy
  [Fear] as IN_Fear
  [Mate] as IN_Mate
}

rectangle "Döntési és akció réteg (Outputs)" {
  [Eat] as OUT_Eat
  [Drink] as OUT_Drink
  [Rest] as OUT_Rest
  [Flee] as OUT_Flee
  [MateAct] as OUT_MateAct
}

' Alapvető fiziológiai kapcsolatok
IN_Hunger --> OUT_Eat : "w[0]"
IN_Thirst --> OUT_Drink : "w[1]"
IN_Energy --> OUT_Rest : "w[2]"
IN_Fear --> OUT_Flee : "w[3]"
IN_Mate --> OUT_MateAct : "w[4]"

' Keresztirányú komplex kapcsolatok
IN_Fear --> OUT_Eat : "w[5] (Kockázat)"
IN_Energy --> OUT_MateAct : "w[6]"
IN_Hunger --> OUT_Rest : "w[7]"

@enduml